# EvrakPlus Ders Dağıtım Multi Plus - Örnek Ortam Değişkenleri
# Gerçek değerleri .env dosyasına yazın. .env dosyası Git'e yüklenmez.

EVRAKPLUS_SITE_URL=https://www.evrakplus.com
EVRAKPLUS_WEB_APP_URL=https://www.evrakplus.com/ders-dagitim-multi-plus/
EVRAKPLUS_LOGIN_URL=https://www.evrakplus.com/giris
EVRAKPLUS_API_BASE=https://www.evrakplus.com/wp-json/evrakplus/v1

# cPanel Web / MySQL (yalnızca sunucu kurulumu için)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=evrakplus_multi_plus
DB_USER=
DB_PASS=

# Bağımsız Linux/VPS Solver Server (isteğe bağlı)
SOLVER_SERVER_URL=
SOLVER_SERVER_API_KEY=
SOLVER_MAX_WORKERS=4
SOLVER_MAX_MEMORY_MB=4096

# Geliştirme amaçlı yerel HTTP izni (üretimde kapalı tutun)
EVRAKPLUS_ALLOW_LOCAL_HTTP=0
